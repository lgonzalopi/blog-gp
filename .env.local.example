# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube a git (ya está en .gitignore).

# Supabase — Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clave para entrar en modo autor (reemplaza a la anterior CLAVE_AUTOR del componente)
AUTHOR_PASSWORD=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# URL pública del sitio, para que los metadatos Open Graph (preview en
# LinkedIn) armen bien los links. Actualizar al tener dominio propio.
#
# Debe incluir el protocolo: https://midominio.com  (no "midominio.com").
# Si se deja vacía, en Vercel se usa sola la dirección del despliegue.
NEXT_PUBLIC_SITE_URL=
